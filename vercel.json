{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/update-current-year",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/ingest-championship",
      "schedule": "0 1 * * *"
    },
    {
       "path": "/cron/archive-historic",
       "schedule": "0 2 1 1 *"
    },
    {
      "path": "/cron/validate-timeline-tweets",
      "schedule": "0 23 * * *"
    }
  ]
}
